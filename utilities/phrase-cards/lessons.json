{
  "packId": "malay-survival",
  "language": "ms",
  "locale": "ms-MY",
  "voice": "ms-MY-Wavenet-A",
  "title": "Malay 15-min",
  "days": [
    {
      "id": "ms-d01",
      "day": 1,
      "title": "Introductions",
      "theme": "polite",
      "lines": [
        {"id": "ms-d01-01", "text": "Saya adalah [name].", "speak": "Saya adalah Ali.", "formal": "Saya adalah [name].", "meaning": "I am [name].", "stress": "SAH-yah ah-DAH-lah", "audioPath": "phraseAudio/ms/ms-d01-01.mp3"},
        {"id": "ms-d01-02", "text": "Nama saya [name].", "speak": "Nama saya Ali.", "formal": "Nama saya [name].", "meaning": "My name is [name].", "stress": "NAH-mah SAH-yah", "audioPath": "phraseAudio/ms/ms-d01-02.mp3"},
        {"id": "ms-d01-03", "text": "Nama anda apa?", "speak": "Nama anda apa?", "meaning": "What's your name?", "stress": "NAH-mah AHN-dah AH-pah", "audioPath": "phraseAudio/ms/ms-d01-03.mp3"},
        {"id": "ms-d01-04", "text": "Senang bertemu anda.", "speak": "Senang bertemu anda.", "meaning": "Nice to meet you.", "stress": "seh-NAHNG ber-teh-MOO AHN-dah", "audioPath": "phraseAudio/ms/ms-d01-04.mp3"},
        {"id": "ms-d01-05", "text": "Anda adalah guru saya.", "speak": "Anda adalah guru saya.", "meaning": "You are my teacher.", "stress": "AHN-dah ah-DAH-lah GOO-roo SAH-yah", "audioPath": "phraseAudio/ms/ms-d01-05.mp3"}
      ]
    },
    {
      "id": "ms-d02",
      "day": 2,
      "title": "Greetings",
      "theme": "polite",
      "lines": [
        {"id": "ms-d02-01", "text": "Selamat pagi!", "speak": "Selamat pagi!", "meaning": "Good morning!", "stress": "suh-LAH-maht PAH-gee", "audioPath": "phraseAudio/ms/ms-d02-01.mp3"},
        {"id": "ms-d02-02", "text": "Selamat petang!", "speak": "Selamat petang!", "meaning": "Good afternoon / evening!", "stress": "suh-LAH-maht peh-TAHNG", "audioPath": "phraseAudio/ms/ms-d02-02.mp3"},
        {"id": "ms-d02-03", "text": "Apa khabar?", "speak": "Apa khabar?", "meaning": "How are you?", "stress": "AH-pah KAH-bar", "audioPath": "phraseAudio/ms/ms-d02-03.mp3"},
        {"id": "ms-d02-04", "text": "Saya baik, terima kasih.", "speak": "Saya baik, terima kasih.", "meaning": "I'm good, thank you.", "stress": "SAH-yah BYE-ek, teh-REE-mah KAH-seeh", "audioPath": "phraseAudio/ms/ms-d02-04.mp3"},
        {"id": "ms-d02-05", "text": "Dan anda?", "speak": "Dan anda?", "meaning": "And you?", "stress": "dahn AHN-dah", "audioPath": "phraseAudio/ms/ms-d02-05.mp3"},
        {"id": "ms-d02-06", "text": "Anda cakap Melayu?", "speak": "Anda cakap Melayu?", "meaning": "Do you speak Malay?", "stress": "AHN-dah CHA-kap meh-LAH-yoo", "audioPath": "phraseAudio/ms/ms-d02-06.mp3"},
        {"id": "ms-d02-07", "text": "Sedikit sahaja, saya sedang belajar.", "speak": "Sedikit sahaja, saya sedang belajar.", "meaning": "Very little, I'm just learning.", "stress": "seh-DEE-keet sah-HAH-jah", "audioPath": "phraseAudio/ms/ms-d02-07.mp3"}
      ]
    },
    {
      "id": "ms-d03",
      "day": 3,
      "title": "Thanks, please, yes / no",
      "theme": "polite",
      "lines": [
        {"id": "ms-d03-01", "text": "Terima kasih.", "speak": "Terima kasih.", "meaning": "Thank you.", "stress": "teh-REE-mah KAH-seeh", "audioPath": "phraseAudio/ms/ms-d03-01.mp3"},
        {"id": "ms-d03-02", "text": "Sama-sama.", "speak": "Sama-sama.", "meaning": "You're welcome.", "stress": "SAH-mah SAH-mah", "audioPath": "phraseAudio/ms/ms-d03-02.mp3"},
        {"id": "ms-d03-03", "text": "Tolong.", "speak": "Tolong.", "meaning": "Please / Help!", "stress": "TOH-long", "audioPath": "phraseAudio/ms/ms-d03-03.mp3"},
        {"id": "ms-d03-04", "text": "Boleh tolong saya?", "speak": "Boleh tolong saya?", "meaning": "Can you help me?", "stress": "BOH-leh TOH-long SAH-yah", "audioPath": "phraseAudio/ms/ms-d03-04.mp3"},
        {"id": "ms-d03-05", "text": "Ya.", "speak": "Ya.", "meaning": "Yes.", "stress": "YAH", "audioPath": "phraseAudio/ms/ms-d03-05.mp3"},
        {"id": "ms-d03-06", "text": "Tidak.", "speak": "Tidak.", "formal": "Tidak.", "meaning": "No.", "stress": "TEE-dahk", "audioPath": "phraseAudio/ms/ms-d03-06.mp3"},
        {"id": "ms-d03-07", "text": "Tidak apa.", "speak": "Tidak apa.", "formal": "Tidak apa.", "meaning": "No problem / It's okay.", "stress": "TEE-dahk AH-pah", "audioPath": "phraseAudio/ms/ms-d03-07.mp3"},
        {"id": "ms-d03-08", "text": "Tak apa lah!", "speak": "Tak apa lah!", "formal": "Tidak apa.", "meaning": "No problem (spoken).", "stress": "tahk AH-pah lah", "audioPath": "phraseAudio/ms/ms-d03-08.mp3"},
        {"id": "ms-d03-09", "text": "Boleh boleh!", "speak": "Boleh boleh!", "meaning": "Sure! / Can do!", "stress": "BOH-leh BOH-leh", "audioPath": "phraseAudio/ms/ms-d03-09.mp3"}
      ]
    },
    {
      "id": "ms-d04",
      "day": 4,
      "title": "Numbers 1–10 + how much",
      "theme": "shop",
      "lines": [
        {"id": "ms-d04-01", "text": "satu, dua, tiga, empat, lima", "speak": "satu, dua, tiga, empat, lima", "meaning": "1, 2, 3, 4, 5", "stress": "SAH-too DOO-ah TEE-gah EM-paht LEE-mah", "audioPath": "phraseAudio/ms/ms-d04-01.mp3"},
        {"id": "ms-d04-02", "text": "enam, tujuh, lapan, sembilan, sepuluh", "speak": "enam, tujuh, lapan, sembilan, sepuluh", "meaning": "6, 7, 8, 9, 10", "stress": "EH-nahm TOO-joo LAH-pahn sem-BEE-lahn seh-POO-loo", "audioPath": "phraseAudio/ms/ms-d04-02.mp3"},
        {"id": "ms-d04-03", "text": "Berapa?", "speak": "Berapa?", "meaning": "How much?", "stress": "beh-RAH-pah", "audioPath": "phraseAudio/ms/ms-d04-03.mp3"},
        {"id": "ms-d04-04", "text": "Berapa ringgit?", "speak": "Berapa ringgit?", "meaning": "How much in ringgit?", "stress": "beh-RAH-pah RING-git", "audioPath": "phraseAudio/ms/ms-d04-04.mp3"},
        {"id": "ms-d04-05", "text": "Murah sikit boleh?", "speak": "Murah sikit boleh?", "meaning": "A bit cheaper, can?", "stress": "MOO-rah SEE-keet BOH-leh", "audioPath": "phraseAudio/ms/ms-d04-05.mp3"},
        {"id": "ms-d04-06", "text": "Mahal lah!", "speak": "Mahal lah!", "meaning": "So expensive lah!", "stress": "mah-HAHL lah", "audioPath": "phraseAudio/ms/ms-d04-06.mp3"}
      ]
    },
    {
      "id": "ms-d05",
      "day": 5,
      "title": "I want / this / order",
      "theme": "food",
      "lines": [
        {"id": "ms-d05-01", "text": "Saya mahu ini.", "speak": "Saya mahu ini.", "formal": "Saya mahu ini.", "meaning": "I want this.", "stress": "SAH-yah MAH-hoo EE-nee", "audioPath": "phraseAudio/ms/ms-d05-01.mp3"},
        {"id": "ms-d05-02", "text": "Yang ini.", "speak": "Yang ini.", "meaning": "This one.", "stress": "yahng EE-nee", "audioPath": "phraseAudio/ms/ms-d05-02.mp3"},
        {"id": "ms-d05-03", "text": "Makan di sini.", "speak": "Makan di sini.", "meaning": "Eat here.", "stress": "MAH-kahn dee SEE-nee", "audioPath": "phraseAudio/ms/ms-d05-03.mp3"},
        {"id": "ms-d05-04", "text": "Bungkus.", "speak": "Bungkus.", "meaning": "Takeaway / wrap it.", "stress": "BOONG-koos", "audioPath": "phraseAudio/ms/ms-d05-04.mp3"},
        {"id": "ms-d05-05", "text": "Menu ada?", "speak": "Menu ada?", "meaning": "Do you have a menu?", "stress": "MEH-noo AH-dah", "audioPath": "phraseAudio/ms/ms-d05-05.mp3"}
      ]
    },
    {
      "id": "ms-d06",
      "day": 6,
      "title": "Taste / extras",
      "theme": "food",
      "lines": [
        {"id": "ms-d06-01", "text": "Pedas.", "speak": "Pedas.", "meaning": "Spicy.", "stress": "peh-DAHS", "audioPath": "phraseAudio/ms/ms-d06-01.mp3"},
        {"id": "ms-d06-02", "text": "Kurang pedas.", "speak": "Kurang pedas.", "meaning": "Less spicy.", "stress": "KOO-rahng peh-DAHS", "audioPath": "phraseAudio/ms/ms-d06-02.mp3"},
        {"id": "ms-d06-03", "text": "Tak mahu pedas.", "speak": "Tak mahu pedas.", "formal": "Tidak mahu pedas.", "meaning": "I don't want it spicy.", "stress": "tahk MAH-hoo peh-DAHS", "audioPath": "phraseAudio/ms/ms-d06-03.mp3"},
        {"id": "ms-d06-04", "text": "Tambah telur.", "speak": "Tambah telur.", "meaning": "Add egg.", "stress": "TAHM-bah teh-LOOR", "audioPath": "phraseAudio/ms/ms-d06-04.mp3"},
        {"id": "ms-d06-05", "text": "Nasi atau mee?", "speak": "Nasi atau mee?", "meaning": "Rice or noodles?", "stress": "NAH-see ah-TAU mee", "audioPath": "phraseAudio/ms/ms-d06-05.mp3"}
      ]
    },
    {
      "id": "ms-d07",
      "day": 7,
      "title": "Drinks",
      "theme": "food",
      "lines": [
        {"id": "ms-d07-01", "text": "Teh tarik, terima kasih.", "speak": "Teh tarik, terima kasih.", "meaning": "Pulled tea, thank you.", "stress": "teh TAH-rik", "audioPath": "phraseAudio/ms/ms-d07-01.mp3"},
        {"id": "ms-d07-02", "text": "Kopi-O.", "speak": "Kopi O.", "meaning": "Black coffee (kopitiam).", "stress": "KOH-pee OH", "audioPath": "phraseAudio/ms/ms-d07-02.mp3"},
        {"id": "ms-d07-03", "text": "Air kosong.", "speak": "Air kosong.", "meaning": "Plain water.", "stress": "AH-yer KOH-song", "audioPath": "phraseAudio/ms/ms-d07-03.mp3"},
        {"id": "ms-d07-04", "text": "Tak mahu ais.", "speak": "Tak mahu ais.", "formal": "Tidak mahu ais.", "meaning": "No ice.", "stress": "tahk MAH-hoo ice", "audioPath": "phraseAudio/ms/ms-d07-04.mp3"},
        {"id": "ms-d07-05", "text": "Satu lagi, boleh?", "speak": "Satu lagi, boleh?", "meaning": "One more, can?", "stress": "SAH-too LAH-gee BOH-leh", "audioPath": "phraseAudio/ms/ms-d07-05.mp3"}
      ]
    },
    {
      "id": "ms-d08",
      "day": 8,
      "title": "At the table",
      "theme": "food",
      "lines": [
        {"id": "ms-d08-01", "text": "Sedap!", "speak": "Sedap!", "meaning": "Delicious!", "stress": "seh-DAHP", "audioPath": "phraseAudio/ms/ms-d08-01.mp3"},
        {"id": "ms-d08-02", "text": "Lagi satu.", "speak": "Lagi satu.", "meaning": "One more.", "stress": "LAH-gee SAH-too", "audioPath": "phraseAudio/ms/ms-d08-02.mp3"},
        {"id": "ms-d08-03", "text": "Boleh kongsikan?", "speak": "Boleh kongsikan?", "meaning": "Can we share?", "stress": "BOH-leh kong-SEE-kahn", "audioPath": "phraseAudio/ms/ms-d08-03.mp3"},
        {"id": "ms-d08-04", "text": "Kira, terima kasih.", "speak": "Kira, terima kasih.", "meaning": "The bill, please.", "stress": "KEE-rah", "audioPath": "phraseAudio/ms/ms-d08-04.mp3"},
        {"id": "ms-d08-05", "text": "Cukup.", "speak": "Cukup.", "meaning": "That's enough.", "stress": "CHOO-koop", "audioPath": "phraseAudio/ms/ms-d08-05.mp3"}
      ]
    },
    {
      "id": "ms-d09",
      "day": 9,
      "title": "Dietary",
      "theme": "food",
      "lines": [
        {"id": "ms-d09-01", "text": "Saya tak makan babi.", "speak": "Saya tak makan babi.", "formal": "Saya tidak makan babi.", "meaning": "I don't eat pork.", "stress": "SAH-yah tahk MAH-kahn BAH-bee", "audioPath": "phraseAudio/ms/ms-d09-01.mp3"},
        {"id": "ms-d09-02", "text": "Ada ayam?", "speak": "Ada ayam?", "meaning": "Is there chicken?", "stress": "AH-dah AH-yahm", "audioPath": "phraseAudio/ms/ms-d09-02.mp3"},
        {"id": "ms-d09-03", "text": "Sayur sahaja.", "speak": "Sayur sahaja.", "meaning": "Vegetables only.", "stress": "SAH-yoor sah-HAH-jah", "audioPath": "phraseAudio/ms/ms-d09-03.mp3"},
        {"id": "ms-d09-04", "text": "Ada kacang?", "speak": "Ada kacang?", "meaning": "Does it have nuts / beans?", "stress": "AH-dah KAH-chahng", "audioPath": "phraseAudio/ms/ms-d09-04.mp3"},
        {"id": "ms-d09-05", "text": "Saya ada alahan.", "speak": "Saya ada alahan.", "meaning": "I have an allergy.", "stress": "SAH-yah AH-dah ah-LAH-hahn", "audioPath": "phraseAudio/ms/ms-d09-05.mp3"}
      ]
    },
    {
      "id": "ms-d10",
      "day": 10,
      "title": "Recycle: food",
      "theme": "food",
      "lines": [
        {"id": "ms-d10-01", "text": "Saya mahu ini.", "speak": "Saya mahu ini.", "meaning": "I want this.", "stress": "SAH-yah MAH-hoo EE-nee", "audioPath": "phraseAudio/ms/ms-d10-01.mp3"},
        {"id": "ms-d10-02", "text": "Berapa ringgit?", "speak": "Berapa ringgit?", "meaning": "How much in ringgit?", "stress": "beh-RAH-pah RING-git", "audioPath": "phraseAudio/ms/ms-d10-02.mp3"},
        {"id": "ms-d10-03", "text": "Terima kasih.", "speak": "Terima kasih.", "meaning": "Thank you.", "stress": "teh-REE-mah KAH-seeh", "audioPath": "phraseAudio/ms/ms-d10-03.mp3"},
        {"id": "ms-d10-04", "text": "Bungkus.", "speak": "Bungkus.", "meaning": "Takeaway.", "stress": "BOONG-koos", "audioPath": "phraseAudio/ms/ms-d10-04.mp3"},
        {"id": "ms-d10-05", "text": "Kurang pedas.", "speak": "Kurang pedas.", "meaning": "Less spicy.", "stress": "KOO-rahng peh-DAHS", "audioPath": "phraseAudio/ms/ms-d10-05.mp3"}
      ]
    },
    {
      "id": "ms-d11",
      "day": 11,
      "title": "Grab",
      "theme": "travel",
      "lines": [
        {"id": "ms-d11-01", "text": "Saya nak ke George Town.", "speak": "Saya nak ke George Town.", "formal": "Saya hendak ke George Town.", "meaning": "I want to go to George Town.", "stress": "SAH-yah nahk keh", "audioPath": "phraseAudio/ms/ms-d11-01.mp3"},
        {"id": "ms-d11-02", "text": "Tunggu di sini.", "speak": "Tunggu di sini.", "meaning": "Wait here.", "stress": "TOONG-goo dee SEE-nee", "audioPath": "phraseAudio/ms/ms-d11-02.mp3"},
        {"id": "ms-d11-03", "text": "Berhenti di sini, terima kasih.", "speak": "Berhenti di sini, terima kasih.", "meaning": "Stop here, thank you.", "stress": "ber-HEN-tee dee SEE-nee", "audioPath": "phraseAudio/ms/ms-d11-03.mp3"},
        {"id": "ms-d11-04", "text": "Berapa lama lagi?", "speak": "Berapa lama lagi?", "meaning": "How much longer?", "stress": "beh-RAH-pah LAH-mah LAH-gee", "audioPath": "phraseAudio/ms/ms-d11-04.mp3"},
        {"id": "ms-d11-05", "text": "Saya turun sini.", "speak": "Saya turun sini.", "meaning": "I'll get off here.", "stress": "SAH-yah TOO-roon SEE-nee", "audioPath": "phraseAudio/ms/ms-d11-05.mp3"}
      ]
    },
    {
      "id": "ms-d12",
      "day": 12,
      "title": "Directions",
      "theme": "travel",
      "lines": [
        {"id": "ms-d12-01", "text": "Di mana?", "speak": "Di mana?", "meaning": "Where?", "stress": "dee MAH-nah", "audioPath": "phraseAudio/ms/ms-d12-01.mp3"},
        {"id": "ms-d12-02", "text": "Jalan terus.", "speak": "Jalan terus.", "meaning": "Go straight.", "stress": "JAH-lahn teh-ROOS", "audioPath": "phraseAudio/ms/ms-d12-02.mp3"},
        {"id": "ms-d12-03", "text": "Belok kiri.", "speak": "Belok kiri.", "meaning": "Turn left.", "stress": "beh-LOHK KEE-ree", "audioPath": "phraseAudio/ms/ms-d12-03.mp3"},
        {"id": "ms-d12-04", "text": "Belok kanan.", "speak": "Belok kanan.", "meaning": "Turn right.", "stress": "beh-LOHK KAH-nahn", "audioPath": "phraseAudio/ms/ms-d12-04.mp3"},
        {"id": "ms-d12-05", "text": "Dekat sini?", "speak": "Dekat sini?", "meaning": "Nearby?", "stress": "deh-KAHT SEE-nee", "audioPath": "phraseAudio/ms/ms-d12-05.mp3"},
        {"id": "ms-d12-06", "text": "Saya sesat.", "speak": "Saya sesat.", "meaning": "I'm lost.", "stress": "SAH-yah seh-SAHT", "audioPath": "phraseAudio/ms/ms-d12-06.mp3"}
      ]
    },
    {
      "id": "ms-d13",
      "day": 13,
      "title": "Places",
      "theme": "travel",
      "lines": [
        {"id": "ms-d13-01", "text": "Tandas di mana?", "speak": "Tandas di mana?", "meaning": "Where is the toilet?", "stress": "TAHN-dahs dee MAH-nah", "audioPath": "phraseAudio/ms/ms-d13-01.mp3"},
        {"id": "ms-d13-02", "text": "Farmasi di mana?", "speak": "Farmasi di mana?", "meaning": "Where is the pharmacy?", "stress": "far-MAH-see dee MAH-nah", "audioPath": "phraseAudio/ms/ms-d13-02.mp3"},
        {"id": "ms-d13-03", "text": "Ada klinik dekat sini?", "speak": "Ada klinik dekat sini?", "meaning": "Is there a clinic nearby?", "stress": "AH-dah KLEE-nik", "audioPath": "phraseAudio/ms/ms-d13-03.mp3"},
        {"id": "ms-d13-04", "text": "ATM ada?", "speak": "ATM ada?", "meaning": "Is there an ATM?", "stress": "A-T-M AH-dah", "audioPath": "phraseAudio/ms/ms-d13-04.mp3"},
        {"id": "ms-d13-05", "text": "Masjid di mana?", "speak": "Masjid di mana?", "meaning": "Where is the mosque?", "stress": "MAHS-jid dee MAH-nah", "audioPath": "phraseAudio/ms/ms-d13-05.mp3"}
      ]
    },
    {
      "id": "ms-d14",
      "day": 14,
      "title": "Time",
      "theme": "time",
      "lines": [
        {"id": "ms-d14-01", "text": "Sekarang.", "speak": "Sekarang.", "meaning": "Now.", "stress": "seh-KAH-rahng", "audioPath": "phraseAudio/ms/ms-d14-01.mp3"},
        {"id": "ms-d14-02", "text": "Nanti.", "speak": "Nanti.", "meaning": "Later.", "stress": "NAHN-tee", "audioPath": "phraseAudio/ms/ms-d14-02.mp3"},
        {"id": "ms-d14-03", "text": "Tunggu sebentar.", "speak": "Tunggu sebentar.", "meaning": "Wait a moment.", "stress": "TOONG-goo seh-BEN-tar", "audioPath": "phraseAudio/ms/ms-d14-03.mp3"},
        {"id": "ms-d14-04", "text": "Pukul berapa?", "speak": "Pukul berapa?", "meaning": "What time?", "stress": "POO-kool beh-RAH-pah", "audioPath": "phraseAudio/ms/ms-d14-04.mp3"},
        {"id": "ms-d14-05", "text": "Awal sikit.", "speak": "Awal sikit.", "meaning": "A bit early.", "stress": "AH-wahl SEE-keet", "audioPath": "phraseAudio/ms/ms-d14-05.mp3"},
        {"id": "ms-d14-06", "text": "Saya lewat.", "speak": "Saya lewat.", "meaning": "I'm late.", "stress": "SAH-yah leh-WAHT", "audioPath": "phraseAudio/ms/ms-d14-06.mp3"}
      ]
    },
    {
      "id": "ms-d15",
      "day": 15,
      "title": "Open / closed",
      "theme": "time",
      "lines": [
        {"id": "ms-d15-01", "text": "Buka?", "speak": "Buka?", "meaning": "Open?", "stress": "BOO-kah", "audioPath": "phraseAudio/ms/ms-d15-01.mp3"},
        {"id": "ms-d15-02", "text": "Tutup?", "speak": "Tutup?", "meaning": "Closed?", "stress": "TOO-toop", "audioPath": "phraseAudio/ms/ms-d15-02.mp3"},
        {"id": "ms-d15-03", "text": "Pukul berapa buka?", "speak": "Pukul berapa buka?", "meaning": "What time do you open?", "stress": "POO-kool beh-RAH-pah BOO-kah", "audioPath": "phraseAudio/ms/ms-d15-03.mp3"},
        {"id": "ms-d15-04", "text": "Hari ini tutup.", "speak": "Hari ini tutup.", "meaning": "Closed today.", "stress": "HAH-ree EE-nee TOO-toop", "audioPath": "phraseAudio/ms/ms-d15-04.mp3"},
        {"id": "ms-d15-05", "text": "Esok datang.", "speak": "Esok datang.", "meaning": "Come tomorrow.", "stress": "EH-sohk DAH-tahng", "audioPath": "phraseAudio/ms/ms-d15-05.mp3"}
      ]
    },
    {
      "id": "ms-d16",
      "day": 16,
      "title": "Looking / size",
      "theme": "shop",
      "lines": [
        {"id": "ms-d16-01", "text": "Saya tengok-tengok dulu.", "speak": "Saya tengok-tengok dulu.", "meaning": "I'm just looking first.", "stress": "SAH-yah TENG-ok TENG-ok DOO-loo", "audioPath": "phraseAudio/ms/ms-d16-01.mp3"},
        {"id": "ms-d16-02", "text": "Boleh cuba?", "speak": "Boleh cuba?", "meaning": "Can I try?", "stress": "BOH-leh CHOO-bah", "audioPath": "phraseAudio/ms/ms-d16-02.mp3"},
