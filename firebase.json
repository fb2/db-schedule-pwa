{
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "predeploy": [
        "python3 scripts/check_firebase_hosting_surface.py"
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.rules",
        "**/.*",
        "**/node_modules/**",
        "private/**",
        "scripts/**",
        "**/*.private.json",
        "GITHUB_PAGES_MAINTENANCE.md",
        "README.md",
        "utilities/penang-pulse/guides/posts/**",
        "**/media/orig/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|webmanifest|js|json|css|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "konbini-radar",
      "public": "utilities/konbini-radar",
      "predeploy": [
        "python3 scripts/check_firebase_hosting_surface.py"
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.rules",
        "**/.*",
        "**/node_modules/**",
        "private/**",
        "scripts/**",
        "**/*.private.json"
      ],
      "headers": [
        {
          "source": "**/*.@(html|webmanifest|js|json|css|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "penang-pulse",
      "public": "utilities/penang-pulse",
      "predeploy": [
        "python3 scripts/check_firebase_hosting_surface.py"
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.rules",
        "**/.*",
        "**/node_modules/**",
        "private/**",
        "scripts/**",
        "**/*.private.json",
        "guides/posts/**",
        "**/media/orig/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|json|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|png|webp|gif|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.svg",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=0, must-revalidate"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
